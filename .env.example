BOT_TOKEN=replace-with-botfather-token

# Restrict the bot to your Telegram numeric user ID(s), comma-separated.
# Leave empty only if you intentionally want a public bot.
ALLOWED_USER_IDS=

MAX_UPLOAD_MB=49
MAX_PLAYLIST_ITEMS=500
MAX_DURATION_SECONDS=7200
MAX_CONCURRENT_DOWNLOADS=2
SPOTIFY_AUDIO_FORMAT=mp3
SPOTIFY_BITRATE=192k
PORT=8000

# Optional path to a cookies file inside the container.
# COOKIES_FILE=/app/cookies.txt
